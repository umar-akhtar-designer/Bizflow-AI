# ---------------------------------------------------------------------------
# BizFlow AI environment
# Copy to `.env` for Docker Compose, or `backend/.env` for local development.
# Never commit the filled-in file.
# ---------------------------------------------------------------------------

ENVIRONMENT=production

# PostgreSQL is used by docker-compose. Local development falls back to SQLite
# when this is left unset: sqlite:///./bizflow.db
DATABASE_URL=postgresql+psycopg://bizflow:bizflow@db:5432/bizflow

POSTGRES_DB=bizflow
POSTGRES_USER=bizflow
POSTGRES_PASSWORD=change-this-database-password

# Generate one with: openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Seed the Northwind Supply Co. demo workspace on first boot.
SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# AI provider
# "auto" uses Vultr only when VULTR_INFERENCE_API_KEY is present. Otherwise the
# deterministic planner runs and the UI labels itself clearly as demo mode.
# ---------------------------------------------------------------------------
AI_PROVIDER=auto
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_MODEL=llama-3.1-70b-instruct-fp8
AI_TIMEOUT_SECONDS=25
AI_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Execution and safety
# ---------------------------------------------------------------------------
WORKFLOW_STEP_DELAY_MS=320
WORKFLOW_TIMEOUT_SECONDS=120
RATE_LIMIT_PER_MINUTE=180

# Public port for the compose web container.
APP_PORT=8080

# Bind address for the web container. Use 127.0.0.1 when a host Nginx
# terminates TLS and proxies to this port.
BIND_ADDRESS=0.0.0.0
